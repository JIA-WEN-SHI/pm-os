# OpenAI-compatible provider settings. Keep the real key in .env only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Disable anonymous framework telemetry.
AGNO_TELEMETRY=false

# PM OS conversation executor: agno-assist or hermes-agent.
# Hermes uses the model above; project context stays isolated.
PMOS_CHAT_EXECUTOR=agno-assist
